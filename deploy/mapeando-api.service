[Unit]
Description=Mapa Marciano API (FastAPI)
After=network-online.target

[Service]
EnvironmentFile=/etc/mapeando.env
WorkingDirectory=/opt/mapeando-ando
ExecStart=/opt/mapeando-ando/.venv-api/bin/uvicorn api.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
