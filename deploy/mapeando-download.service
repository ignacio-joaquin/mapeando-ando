[Unit]
Description=Descarga y precomputación del pipeline de Mapa Marciano
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mapeando-ando
EnvironmentFile=/etc/mapeando.env
ExecStart=/usr/bin/env bash /opt/mapeando-ando/deploy/run-pipeline.sh
User=root

[Install]
WantedBy=multi-user.target
