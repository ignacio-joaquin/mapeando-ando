{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git fetch:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python -m json.tool:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(python3 -m json.tool:*)",
      "Bash(bash -n:*)",
      "Bash(pytest:*)",
      "Bash(npm run:*)",
      "Bash(npx tsc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Read(./**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git checkout main:*)"
    ]
  }
}
